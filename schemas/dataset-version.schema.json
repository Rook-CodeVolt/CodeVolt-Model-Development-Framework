{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codevolt.dev/schemas/dataset-version-v1.json",
  "title": "CodeVolt Dataset Version v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id", "version", "content_sha256", "source_ids", "licence_review",
    "privacy_review", "contamination_check", "immutable"
  ],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "licence_review": {"enum": ["passed", "pending", "failed"]},
    "privacy_review": {"enum": ["passed", "pending", "failed"]},
    "contamination_check": {"enum": ["passed", "pending", "failed"]},
    "immutable": {"const": true}
  }
}
